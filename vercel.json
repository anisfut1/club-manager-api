{
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    { "path": "/internal/cron/ffbb", "schedule": "*/15 * * * *" },
    { "path": "/internal/cron/fbi-enqueue", "schedule": "0 * * * *" },
    { "path": "/internal/cron/fbi-jobs", "schedule": "*/5 * * * *" },
    { "path": "/internal/cron/emarque-parse", "schedule": "*/10 * * * *" }
  ]
}
